HERITAGE_BASE_URL=http://127.0.0.1:8081
# Origine HTTPS du même backend pour les visiteurs GitHub Pages.
# Laisser vide pour conserver les essais locaux. Puis lancer scripts/configure_connection.py.
HERITAGE_PUBLIC_BACKEND_URL=
# 1 = accès local sans Discord ; remettre 0 puis redémarrer pour réactiver OAuth2.
# Refusé sur une adresse publique ou derrière un tunnel.
HERITAGE_LOCAL_PREVIEW=0
# 0 = base métier neuve vide ; ne pas injecter les anciens dossiers d’exemple.
HERITAGE_SEED_DEMO_DATA=0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1500958425281204305
HERITAGE_SUPREME_ID=356404251905228802
HERITAGE_EMPLOYEE_ROLE_ID=1500960060203859989
HERITAGE_ACCESS_TTL=30
HERITAGE_SESSION_DAYS=30

# Secret partagé avec le bot existant : au moins 32 caractères aléatoires.
# Ce secret est distinct du jeton Discord. Ne jamais publier le vrai .env.
HERITAGE_CONNECTOR_SECRET=
# 1 seulement après avoir branché le client du bot aux opérations métier.
HERITAGE_BOT_COMMANDS_ENABLED=0
# Adresse utilisée par le bot : HTTP loopback si les deux tournent sur le même PC.
HERITAGE_SITE_URL=http://127.0.0.1:8081

# Plafonds serveur (entiers positifs ; redémarrer après modification).
HERITAGE_VISITOR_PER_MINUTE=180
HERITAGE_VISITOR_WRITES_PER_MINUTE=30
HERITAGE_VISITOR_AUTH_PER_TEN_MINUTES=10
HERITAGE_DISCORD_PER_MINUTE=120
HERITAGE_DISCORD_PER_DAY=10000
HERITAGE_GOOGLE_PER_MINUTE=30
HERITAGE_GOOGLE_PER_DAY=500
